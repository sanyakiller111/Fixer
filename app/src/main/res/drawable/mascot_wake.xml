<?xml version="1.0" encoding="utf-8"?>
<!-- Asleep -> awake: Zzz fades, eyes open, shades drop onto the eyes, smirk; then idle hair sway + glint. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/mascot">
    <target android:name="zzz">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="150" android:propertyName="strokeAlpha" android:valueFrom="1" android:valueTo="0" />
        </aapt:attr>
    </target>
    <target android:name="eyes">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="200" android:propertyName="strokeAlpha" android:startOffset="150" android:valueFrom="1" android:valueTo="0" />
        </aapt:attr>
    </target>
    <target android:name="shades">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="520"
                android:interpolator="@android:interpolator/overshoot"
                android:propertyName="translateY"
                android:valueFrom="-110"
                android:valueTo="0" />
        </aapt:attr>
    </target>
    <target android:name="flat">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="180" android:propertyName="strokeAlpha" android:startOffset="300" android:valueFrom="1" android:valueTo="0" />
        </aapt:attr>
    </target>
    <target android:name="smile">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="220" android:propertyName="strokeAlpha" android:startOffset="380" android:valueFrom="0" android:valueTo="1" />
        </aapt:attr>
    </target>
</animated-vector>
