<?xml version="1.0" encoding="utf-8"?>
<!-- Awake -> asleep: smirk goes flat, shades slide up to the forehead, eyes close, Zzz appears. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/mascot">
    <target android:name="smile">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="180" android:propertyName="strokeAlpha" android:valueFrom="1" android:valueTo="0" />
        </aapt:attr>
    </target>
    <target android:name="flat">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="200" android:propertyName="strokeAlpha" android:startOffset="120" android:valueFrom="0" android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="shades">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="450"
                android:interpolator="@android:interpolator/decelerate_cubic"
                android:propertyName="translateY"
                android:valueFrom="0"
                android:valueTo="-110" />
        </aapt:attr>
    </target>
    <target android:name="eyes">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="200" android:propertyName="strokeAlpha" android:startOffset="250" android:valueFrom="0" android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="zzz">
        <aapt:attr name="android:animation">
            <objectAnimator android:duration="300" android:propertyName="strokeAlpha" android:startOffset="450" android:valueFrom="0" android:valueTo="1" />
        </aapt:attr>
    </target>
</animated-vector>
